{
  "name": "malachimuhic-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "predeploy": "turbo run build --filter=@malachimuhic/web",
    "deploy": "gh-pages -d docs"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "turbo": "^2.3.3"
  }
}
